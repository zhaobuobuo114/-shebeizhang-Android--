<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 纯本地应用：不联网、不申请任何权限 -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <!--
          configChanges：切昼夜模式（uiMode）时不重建 Activity。
          鸿蒙版换肤只是改 @State，整棵组件树原地更新、动画连续播完；
          安卓默认会销毁重建，界面等于重来一遍（数字动画重播、列表重建、闪一下）。
          这里声明自行处理，让换肤动画和鸿蒙一样在同一棵树里连续播完。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="uiMode|colorMode|screenLayout|screenSize|smallestScreenSize|density|fontScale|layoutDirection|keyboardHidden|orientation"
            android:windowSoftInputMode="adjustResize|stateHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
